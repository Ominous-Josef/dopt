{
  "schema": 2,
  "app_id": "jetbrains-toolbox",
  "name": "JetBrains Toolbox",
  "comment": "JetBrains tools manager",
  "binary_pattern": "jetbrains-toolbox",
  "symlink_as": "jetbrains-toolbox",
  "categories": "Development;IDE;",
  "source": {
    "type": "api",
    "endpoint": "https://data.services.jetbrains.com/products/releases?code=TBA&latest=true&type=release",
    "jq_query": ".TBA[0].downloads | if $arch == \"arm64\" then .linuxARM64 else .linux end | .link",
    "checksum_query": ".TBA[0].downloads | if $arch == \"arm64\" then .linuxARM64 else .linux end | .checksumLink"
  }
}
